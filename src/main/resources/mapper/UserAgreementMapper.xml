<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.gpt.chatproject.dao.UserAgreementDao">

    <resultMap id="UserAgreementMap" type="com.gpt.chatproject.entity.UserAgreement">
        <id property="id" column="id" />
        <result property="svcAgmt" column="svc_agmt" />
    </resultMap>

    <insert id="insert" parameterType="com.gpt.chatproject.entity.UserAgreement" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user_agreement (svc_agmt)
        VALUES (#{svcAgmt})
    </insert>

    <update id="update" parameterType="com.gpt.chatproject.entity.UserAgreement">
        UPDATE user_agreement
        SET svc_agmt = #{svcAgmt}
        WHERE id = #{id}
    </update>

    <delete id="delete" parameterType="int">
        DELETE FROM user_agreement WHERE id = #{id}
    </delete>

    <select id="findById" resultMap="UserAgreementMap" parameterType="int">
        SELECT * FROM user_agreement WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="UserAgreementMap">
        SELECT * FROM user_agreement
    </select>
</mapper>
